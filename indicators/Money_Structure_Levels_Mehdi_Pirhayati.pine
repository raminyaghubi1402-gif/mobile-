//@version=6
indicator("Money Structure Levels [Mehdi Pirhayati]", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

//══════════════════════════════════════════════════════════════════════════════
// SUPERTREND (مستقل - پیشوند st_)
//══════════════════════════════════════════════════════════════════════════════
st_Periods      = input.int(10, "ATR Period", group="① Supertrend")
st_src          = input.source(hl2, "Source", group="① Supertrend")
st_Multiplier   = input.float(3.0, "ATR Multiplier", step=0.1, group="① Supertrend")
st_changeATR    = input.bool(true, "Change ATR Calculation Method ?", group="① Supertrend")
st_showsignals  = input.bool(true, "Show Buy/Sell Signals ?", group="① Supertrend")
st_highlighting = input.bool(true, "Highlighter On/Off ?", group="① Supertrend")

st_atr2 = ta.sma(ta.tr(true), st_Periods)
st_atr  = st_changeATR ? ta.atr(st_Periods) : st_atr2

var float st_up = na
var float st_dn = na
var int st_trend = 1

st_up := st_src - (st_Multiplier * st_atr)
st_up1 = nz(st_up[1], st_up)
st_up := close[1] > st_up1 ? math.max(st_up, st_up1) : st_up

st_dn := st_src + (st_Multiplier * st_atr)
st_dn1 = nz(st_dn[1], st_dn)
st_dn := close[1] < st_dn1 ? math.min(st_dn, st_dn1) : st_dn

st_trend := nz(st_trend[1], st_trend)
st_trend := st_trend == -1 and close > st_dn1 ? 1 : st_trend == 1 and close < st_up1 ? -1 : st_trend

st_upPlot = plot(st_trend == 1 ? st_up : na, "ST Up Trend", style=plot.style_linebr, linewidth=2, color=color.new(#00E676, 0))
st_buySignal = st_trend == 1 and st_trend[1] == -1
plotshape(st_buySignal ? st_up : na, "ST UpTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#00E676, 0))
plotshape(na, "ST Buy", text="ST Buy", location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(#00E676, 0), textcolor=color.white)

st_dnPlot = plot(st_trend == 1 ? na : st_dn, "ST Down Trend", style=plot.style_linebr, linewidth=2, color=color.new(#FF5252, 0))
st_sellSignal = st_trend == -1 and st_trend[1] == 1
plotshape(st_sellSignal ? st_dn : na, "ST DownTrend Begins", location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(#FF5252, 0))
plotshape(na, "ST Sell", text="ST Sell", location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(#FF5252, 0), textcolor=color.white)

st_mPlot = plot(ohlc4, title="", display=display.none)
st_longFill  = st_highlighting ? (st_trend == 1 ? color.new(#00E676, 90) : color.new(color.white, 100)) : color.new(color.white, 100)
st_shortFill = st_highlighting ? (st_trend == -1 ? color.new(#FF5252, 90) : color.new(color.white, 100)) : color.new(color.white, 100)
fill(st_mPlot, st_upPlot, title="ST Up Highlighter", color=st_longFill)
fill(st_mPlot, st_dnPlot, title="ST Down Highlighter", color=st_shortFill)

alertcondition(st_buySignal, "SuperTrend Buy", "SuperTrend Buy!")
alertcondition(st_sellSignal, "SuperTrend Sell", "SuperTrend Sell!")
alertcondition(st_trend != st_trend[1], "SuperTrend Direction Change", "SuperTrend has changed direction!")

//══════════════════════════════════════════════════════════════════════════════
// @Aitradeforex ( Telegram )
//══════════════════════════════════════════════════════════════════════════════

colors     = input.string("DARK", "Color Scheme", options=["DARK", "LIGHT"], group="Color Scheme")
bullcolor  = colors == "DARK" ? #0043e0 : color.rgb(0, 255, 8)
bearcolor  = colors == "DARK" ? #F2003C : color.rgb(255, 0, 0)

Show_Signals = input.bool(true, "Show Signal", tooltip="Show Long & Short Signals", group="Signal's Settings")

length_input   = input.int(1, "Period", group="Signal's Settings")
mult_input     = input.float(8, "TBSensitivity", step=0.1, group="Signal's Settings")
SFilter_input  = input.float(1.0, "Signal Filter", step=0.1, group="Signal's Settings")

t_type = input.string("Default", "Strategy", options=["Default", "Scalping", "Intraday", "Swing"], group="Signal's Settings")

int length = t_type == "Scalping" ? 10 : t_type == "Intraday" ? 2 : t_type == "Swing" ? 10 : length_input
float mult = t_type == "Scalping" ? 10.0 : t_type == "Intraday" ? 15.0 : t_type == "Swing" ? 5.0 : mult_input
float SFilter = t_type == "Scalping" ? 0.5 : t_type == "Intraday" ? 0.5 : t_type == "Swing" ? 1.2 : SFilter_input

ma2On      = input.bool(true, "Vortex Cloud", group="Cloud")
TBSENSIII  = input.int(2, "Vortex Cloud Sensitivity", group="Cloud")

plotRibsw      = input.bool(true, "Show Trend Ribbon", inline="RIBBON", group="Chart Features")
xfixtf         = input.bool(false, "MTF", inline="RIBBON", group="Chart Features")
labelSwitch    = input.bool(false, "Table", inline="RIBBON", group="Chart Features")
plotRibbonPos  = input.string("Bottom", "Ribbon Position", options=["Top", "Bottom"], group="Chart Features")
xtf            = input.timeframe("D", "Select MTF Ribbon", group="Chart Features")

color CLEAR = color.rgb(0, 0, 0, 100)
showSMC     = input.bool(true, "Show Smart Money Concepts", tooltip="Show Market Structure", group="Market Structure")
showSwing   = input.bool(false, "Show Swing Points", tooltip="Show or hide HH, LH, HL, LL", group="Market Structure")
swingSize   = input.int(10, "Swing Length", group="Market Structure")
bosConfType = input.string("Candle Close", "BOS/CHoCH Confirmation", ["Candle Close", "Wicks"], group="Market Structure")
choch       = true
bosStyle    = input.string("Solid", "Line Style", ["Solid", "Dashed", "Dotted"], group="Market Structure")
bosWidth    = input.int(2, "Width", minval=1, group="Market Structure")

Show_PR  = input.bool(true, "Show Top/Bottom", group="Top / Bottom")
TBSensi  = input.int(5, "Top/Bottom Sensitivity", group="Top / Bottom")

// Core calculation
atr = mult * ta.atr(length)
longStop = hl2 - atr * SFilter
longStopPrev = nz(longStop[1], longStop)
longStop := close[1] > longStopPrev ? math.max(longStop, longStopPrev) : longStop

shortStop = hl2 + atr * SFilter
shortStopPrev = nz(shortStop[1], shortStop)
shortStop := close[1] < shortStopPrev ? math.min(shortStop, shortStopPrev) : shortStop

dir = 1
dir := nz(dir[1], dir)
dir := dir == -1 and close > shortStopPrev ? 1 : dir == 1 and close < longStopPrev ? -1 : dir

longCond  = ta.crossover(close[1], shortStopPrev)
shortCond = ta.crossunder(close[1], longStopPrev)
longCond2 = longCond
shortCond2 = shortCond
longCond3 = longCond
shortCond3 = shortCond

sectionLongs = 0
sectionLongs := nz(sectionLongs[1])
sectionShorts = 0
sectionShorts := nz(sectionShorts[1])
if longCond
    sectionLongs += 1
    sectionShorts := 0
if shortCond
    sectionLongs := 0
    sectionShorts += 1

sectionLongs2 = 0
sectionLongs2 := nz(sectionLongs2[1])
sectionShorts2 = 0
sectionShorts2 := nz(sectionShorts2[1])
if longCond2
    sectionLongs2 += 1
    sectionShorts2 := 0
if shortCond2
    sectionLongs2 := 0
    sectionShorts2 += 1

sectionLongs3 = 0
sectionLongs3 := nz(sectionLongs3[1])
sectionShorts3 = 0
sectionShorts3 := nz(sectionShorts3[1])
if longCond3
    sectionLongs3 += 1
    sectionShorts3 := 0
if shortCond3
    sectionLongs3 := 0
    sectionShorts3 += 1

pyrl = 1
pyr2 = 1
pyr3 = 1

longCondition  = longCond  and sectionLongs  <= pyrl
shortCondition = shortCond and sectionShorts <= pyrl
longCondition2 = longCond2 and sectionLongs2 <= pyr2
shortCondition2 = shortCond2 and sectionShorts2 <= pyr2
longCondition3 = longCond3 and sectionLongs3 <= pyr3
shortCondition3 = shortCond3 and sectionShorts3 <= pyr3

last_open_longCondition  = float(na)
last_open_shortCondition = float(na)
last_open_longCondition  := longCondition  ? open : nz(last_open_longCondition[1])
last_open_shortCondition := shortCondition ? open : nz(last_open_shortCondition[1])

last_open_longCondition2  = float(na)
last_open_shortCondition2 = float(na)
last_open_longCondition2  := longCondition2  ? open : nz(last_open_longCondition2[1])
last_open_shortCondition2 := shortCondition2 ? open : nz(last_open_shortCondition2[1])

last_open_longCondition3  = float(na)
last_open_shortCondition3 = float(na)
last_open_longCondition3  := longCondition3  ? open : nz(last_open_longCondition3[1])
last_open_shortCondition3 := shortCondition3 ? open : nz(last_open_shortCondition3[1])

last_longCondition  = float(na)
last_shortCondition = float(na)
last_longCondition  := longCondition  ? time : nz(last_longCondition[1])
last_shortCondition := shortCondition ? time : nz(last_shortCondition[1])
in_longCondition  = last_longCondition > last_shortCondition
in_shortCondition = last_shortCondition > last_longCondition

last_longCondition2  = float(na)
last_shortCondition2 = float(na)
last_longCondition2  := longCondition2  ? time : nz(last_longCondition2[1])
last_shortCondition2 := shortCondition2 ? time : nz(last_shortCondition2[1])
in_longCondition2  = last_longCondition2 > last_shortCondition2
in_shortCondition2 = last_shortCondition2 > last_longCondition2

last_longCondition3  = float(na)
last_shortCondition3 = float(na)
last_longCondition3  := longCondition3  ? time : nz(last_longCondition3[1])
last_shortCondition3 := shortCondition3 ? time : nz(last_shortCondition3[1])
in_longCondition3  = last_longCondition3 > last_shortCondition3
in_shortCondition3 = last_shortCondition3 > last_longCondition3

// AUTO RISK MANAGEMENT v1
Show_SL_TP = input.bool(true, "Show TP/SL Points", group="AUTO RISK MANAGEMENT v1")
isTPl = input.bool(true, "TP - 1", group="AUTO RISK MANAGEMENT v1", inline="ARM")
isTPs = isTPl
tp = input.float(0.25, "Take Profit % - 1")
long_tp  = isTPl and Show_SL_TP and ta.crossover(high, (1 + tp / 100) * last_open_longCondition) and not longCondition and in_longCondition
short_tp = isTPs and Show_SL_TP and ta.crossunder(low, (1 - tp / 100) * last_open_shortCondition) and not shortCondition and in_shortCondition

isTP2 = input.bool(true, "TP - 2", group="AUTO RISK MANAGEMENT v1", inline="ARM")
isTPs2 = isTP2
tp2 = input.float(0.75, "Take Profit % - 2")
long_tp2  = isTP2 and Show_SL_TP and ta.crossover(high, (1 + tp2 / 100) * last_open_longCondition2) and not longCondition2 and in_longCondition2
short_tp2 = isTPs2 and Show_SL_TP and ta.crossunder(low, (1 - tp2 / 100) * last_open_shortCondition2) and not shortCondition2 and in_shortCondition2

isTP3 = input.bool(true, "TP - 3", group="AUTO RISK MANAGEMENT v1", inline="ARM")
isTPs3 = isTP3
tp3 = input.float(1.0, "Take Profit % - 3")
long_tp3  = isTP3 and Show_SL_TP and ta.crossover(high, (1 + tp3 / 100) * last_open_longCondition) and not longCondition and in_longCondition
short_tp3 = isTPs3 and Show_SL_TP and ta.crossunder(low, (1 - tp3 / 100) * last_open_shortCondition) and not shortCondition and in_shortCondition

isSLl = input.bool(false, "Breakeven", group="AUTO RISK MANAGEMENT v1", inline="ARM2")
isSLs = isSLl
sl = input.float(0.4, "Break Even %")
long_sl  = isSLl and Show_SL_TP and ta.crossunder(low, (1 - sl / 100) * last_open_longCondition) and not longCondition and in_longCondition
short_sl = isSLs and Show_SL_TP and ta.crossover(high, (1 + sl / 100) * last_open_shortCondition) and not shortCondition and in_shortCondition

isSLl2 = input.bool(false, "Stop Loss", group="AUTO RISK MANAGEMENT v1", inline="ARM2")
isSLs2 = isSLl2
sl2 = input.float(0.4, "Stop Loss %")
long_sl2  = isSLl2 and Show_SL_TP and ta.crossunder(low, (1 - sl2 / 100) * last_open_longCondition2) and not longCondition2 and in_longCondition2
short_sl2 = isSLs2 and Show_SL_TP and ta.crossover(high, (1 + sl2 / 100) * last_open_shortCondition2) and not shortCondition2 and in_shortCondition2

// AUTO RISK MANAGEMENT v2
levels      = input.bool(true, "Show TP/SL Levels", group="AUTO RISK MANAGEMENT v2")
lvlLines    = input.bool(true, "Show Lines ", inline="levels", group="AUTO RISK MANAGEMENT v2")
linesStyle  = input.string("SOLID", "", ["SOLID", "DASHED", "DOTTED"], inline="levels", group="AUTO RISK MANAGEMENT v2")
lvlDistance = input.int(1, "Distance", 1, inline="levels2", group="AUTO RISK MANAGEMENT v2")
lvlDecimals = input.int(2, "   Decimals", 1, 8, inline="levels2", group="AUTO RISK MANAGEMENT v2")
atrRisk     = input.int(1, "Risk % ", 1, group="AUTO RISK MANAGEMENT v2", inline="levels3")
atrLen      = input.int(14, "  ATR Length", 1, group="AUTO RISK MANAGEMENT v2", inline="levels3")
decimals = lvlDecimals == 1 ? "#.#" : lvlDecimals == 2 ? "#.##" : lvlDecimals == 3 ? "#.###" : lvlDecimals == 4 ? "#.####" : lvlDecimals == 5 ? "#.#####" : lvlDecimals == 6 ? "#.######" : lvlDecimals == 7 ? "#.#######" : "#.########"

long_close  = long_tp or long_sl ? 1 : 0
short_close = short_tp or short_sl ? 1 : 0
long_close2 = long_tp2 or long_sl2 ? 1 : 0
short_close2 = short_tp2 or short_sl2 ? 1 : 0
long_close3 = long_tp3 ? 1 : 0
short_close3 = short_tp3 ? 1 : 0

last_long_close  = float(na)
last_short_close = float(na)
last_long_close  := bool(long_close)  ? time : nz(last_long_close[1])
last_short_close := bool(short_close) ? time : nz(last_short_close[1])

last_long_close2  = float(na)
last_short_close2 = float(na)
last_long_close2  := bool(long_close2) ? time : nz(last_long_close2[1])
last_short_close2 := bool(short_close2) ? time : nz(last_short_close2[1])

last_long_close3  = float(na)
last_short_close3 = float(na)
last_long_close3  := bool(long_close3) ? time : nz(last_long_close3[1])
last_short_close3 := bool(short_close3) ? time : nz(last_short_close3[1])

plotchar(long_tp and last_longCondition > nz(last_long_close[1]), char="✅", text="TP1 LONG", title="TP Long", size=size.tiny, location=location.abovebar, color=color.new(color.green, 0))
plotchar(long_tp2 and last_longCondition2 > nz(last_long_close2[1]), char="✅", text="TP2 LONG", title="TP Long 2", size=size.tiny, location=location.abovebar, color=color.new(color.green, 0))
plotchar(short_tp and last_shortCondition > nz(last_short_close[1]), char="✅", text="TP1 SHORT", title="TP Short", size=size.tiny, location=location.belowbar, color=color.new(color.red, 0))
plotchar(short_tp2 and last_shortCondition2 > nz(last_short_close2[1]), char="✅", text="TP2 SHORT", title="TP Short 2", size=size.tiny, location=location.belowbar, color=color.new(color.red, 0))
plotchar(long_tp3 and last_longCondition3 > nz(last_long_close3[1]), char="✅", text="TP3 LONG", title="TP Long 3", size=size.tiny, location=location.abovebar, color=color.new(color.green, 0))
plotchar(short_tp3 and last_shortCondition3 > nz(last_short_close3[1]), char="✅", text="TP3 SHORT", title="TP Short 3", size=size.tiny, location=location.belowbar, color=color.new(color.red, 0))

plotchar(long_sl and last_longCondition > nz(last_long_close[1]) and isSLl, char="🟢", text="BE LONG", title="Break Even Long", size=size.tiny, location=location.abovebar, color=color.new(color.green, 0))
plotchar(short_sl and last_shortCondition > nz(last_short_close[1]) and isSLl, char="🔴", text="BE SHORT", title="Break Even Short", size=size.tiny, location=location.belowbar, color=color.new(#fd4d4d, 0))
plotchar(long_sl2 and last_longCondition2 > nz(last_long_close2[1]), char="⛔", text="SL LONG", title="Stop Loss Long", size=size.tiny, location=location.abovebar, color=color.new(color.red, 0))
plotchar(short_sl2 and last_shortCondition2 > nz(last_short_close2[1]), char="⛔", text="SL SHORT", title="Stop Loss Short", size=size.tiny, location=location.belowbar, color=color.new(color.red, 0))

// Main Signals
plotshape(dir == 1 and dir[1] == -1 and Show_Signals ? longStop : na, title="BUY", style=shape.labelup, location=location.belowbar, size=size.small, text="LONG", textcolor=color.white, color=bullcolor)
plotshape(dir == -1 and dir[1] == 1 and Show_Signals ? shortStop : na, title="SELL", style=shape.labeldown, location=location.abovebar, size=size.small, text="SHORT", textcolor=color.white, color=bearcolor)

bull = dir == 1 and dir[1] == -1 and Show_Signals ? longStop : na
bear = dir == -1 and dir[1] == 1 and Show_Signals ? shortStop : na

trigger   = not na(bull) ? 1 : 0
countBull = ta.barssince(not na(bull))
countBear = ta.barssince(not na(bear))
atrBand   = ta.atr(atrLen) * atrRisk
atrStop   = trigger == 1 ? low - atrBand : high + atrBand

lastTrade(src) => ta.valuewhen((dir == 1 and dir[1] == -1 and Show_Signals) or (dir == -1 and dir[1] == 1 and Show_Signals), src, 0)

// ────────────────────────────────────────────────────────────────
// FIXED: Levels that NEVER detach when scrolling/panning the chart
// ────────────────────────────────────────────────────────────────
barsSinceSignal = ta.barssince(not na(bull) or not na(bear))

stop_y   = lastTrade(atrStop)
tp1Rl_y  = (lastTrade(close) - lastTrade(atrStop)) * 1 + lastTrade(close)
tp2RL_y  = (lastTrade(close) - lastTrade(atrStop)) * 2 + lastTrade(close)
tp3RL_y  = (lastTrade(close) - lastTrade(atrStop)) * 3 + lastTrade(close)

plot(stop_y,  title="SL",  editable=false, color=#ffffff00)
plot(tp1Rl_y, title="TP1", editable=false, color=#ffffff00)
plot(tp2RL_y, title="TP2", editable=false, color=#ffffff00)
plot(tp3RL_y, title="TP3", editable=false, color=#ffffff00)

entry = levels ? label.new(bar_index + lvlDistance, lastTrade(close), "ENTRY " + str.tostring(lastTrade(close), decimals), xloc.bar_index, yloc.price, color.gray, label.style_label_left, color.white, size.normal) : na
label.delete(entry[1])

stop = levels ? label.new(bar_index + lvlDistance, stop_y, "SL " + str.tostring(stop_y, decimals), xloc.bar_index, yloc.price, bearcolor, label.style_label_left, color.white, size.normal) : na
label.delete(stop[1])

tp1Rl = levels ? label.new(bar_index + lvlDistance, tp1Rl_y, "1:1 TP " + str.tostring(tp1Rl_y, decimals), xloc.bar_index, yloc.price, bullcolor, label.style_label_left, color.white, size.normal) : na
label.delete(tp1Rl[1])

tp2RL = levels ? label.new(bar_index + lvlDistance, tp2RL_y, "2:1 TP " + str.tostring(tp2RL_y, decimals), xloc.bar_index, yloc.price, bullcolor, label.style_label_left, color.white, size.normal) : na
label.delete(tp2RL[1])

tp3RL = levels ? label.new(bar_index + lvlDistance, tp3RL_y, "3:1 TP " + str.tostring(tp3RL_y, decimals), xloc.bar_index, yloc.price, bullcolor, label.style_label_left, color.white, size.normal) : na
label.delete(tp3RL[1])

style = linesStyle == "SOLID" ? line.style_solid : linesStyle == "DASHED" ? line.style_dashed : line.style_dotted

lineEntry = levels and lvlLines ? line.new(bar_index - barsSinceSignal, lastTrade(close), bar_index + lvlDistance, lastTrade(close), xloc.bar_index, extend.none, #1A1A1A, style, 2) : na
line.delete(lineEntry[1])

lineStop = levels and lvlLines ? line.new(bar_index - barsSinceSignal, stop_y, bar_index + lvlDistance, stop_y, xloc.bar_index, extend.none, #CC0000, style, 2) : na
line.delete(lineStop[1])

lineTp1Rl = levels and lvlLines ? line.new(bar_index - barsSinceSignal, tp1Rl_y, bar_index + lvlDistance, tp1Rl_y, xloc.bar_index, extend.none, bullcolor, style, 2) : na
line.delete(lineTp1Rl[1])

lineTp2RL = levels and lvlLines ? line.new(bar_index - barsSinceSignal, tp2RL_y, bar_index + lvlDistance, tp2RL_y, xloc.bar_index, extend.none, bullcolor, style, 2) : na
line.delete(lineTp2RL[1])

lineTp3RL = levels and lvlLines ? line.new(bar_index - barsSinceSignal, tp3RL_y, bar_index + lvlDistance, tp3RL_y, xloc.bar_index, extend.none, bullcolor, style, 2) : na
line.delete(lineTp3RL[1])

// SMC
lineStyle(x) =>
    switch x
        "Solid"  => line.style_solid
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

pivHi = ta.pivothigh(high, swingSize, swingSize)
pivLo = ta.pivotlow(low, swingSize, swingSize)

var float prevHigh = na
var float prevLow = na
var int prevHighIndex = na
var int prevLowIndex = na
var bool highActive = false
var bool lowActive = false
var int prevSwing = 0
var int prevBreakoutDir = 0

bool hh = false
bool lh = false
bool hl = false
bool ll = false

if not na(pivHi)
    if pivHi >= prevHigh
        hh := true
        prevSwing := 2
    else
        lh := true
        prevSwing := 1
    prevHigh := pivHi
    highActive := true
    prevHighIndex := bar_index - swingSize

if not na(pivLo)
    if na(prevLow) or pivLo >= prevLow
        hl := true
        prevSwing := -1
    else
        ll := true
        prevSwing := -2
    prevLow := pivLo
    lowActive := true
    prevLowIndex := bar_index - swingSize

bool highBroken = false
bool lowBroken = false
float highSrc = bosConfType == "Candle Close" ? close : high
float lowSrc  = bosConfType == "Candle Close" ? close : low

if highSrc > prevHigh and highActive
    highBroken := true
    highActive := false
if lowSrc < prevLow and lowActive
    lowBroken := true
    lowActive := false

if hh and showSwing
    label.new(bar_index - swingSize, pivHi, "HH", color=CLEAR, style=label.style_label_down, textcolor=chart.fg_color)
if lh and showSwing
    label.new(bar_index - swingSize, pivHi, "LH", color=CLEAR, style=label.style_label_down, textcolor=chart.fg_color)
if hl and showSwing
    label.new(bar_index - swingSize, pivLo, "HL", color=CLEAR, style=label.style_label_up, textcolor=chart.fg_color)
if ll and showSwing
    label.new(bar_index - swingSize, pivLo, "LL", color=CLEAR, style=label.style_label_up, textcolor=chart.fg_color)

if highBroken and showSMC
    line.new(prevHighIndex, prevHigh, bar_index, prevHigh, color=bullcolor, style=lineStyle(bosStyle), width=bosWidth)
    label.new(math.floor(bar_index - (bar_index - prevHighIndex) / 2), prevHigh, prevBreakoutDir == -1 and choch ? "CHoCH" : "BOS", color=CLEAR, textcolor=bullcolor, size=size.tiny)
    prevBreakoutDir := 1

if lowBroken and showSMC
    line.new(prevLowIndex, prevLow, bar_index, prevLow, color=bearcolor, style=lineStyle(bosStyle), width=bosWidth)
    label.new(math.floor(bar_index - (bar_index - prevLowIndex) / 2), prevLow, prevBreakoutDir == 1 and choch ? "CHoCH" : "BOS", color=CLEAR, textcolor=bearcolor, style=label.style_label_up, size=size.tiny)
    prevBreakoutDir := -1

// Trend Cloud
length2 = 10 * (TBSENSIII / 2)
source2 = close
aboveColor2 = color.rgb(70, 219, 255, 100)
belowColor2 = color.rgb(233, 30, 99, 100)

ma3On = true
length3 = 40 * (TBSENSIII / 2)
source3 = close
aboveColor3 = color.rgb(70, 219, 255, 100)
belowColor3 = color.rgb(233, 30, 99, 100)

sma2 = ta.sma(source2, length2)
ema2 = ta.ema(source2, length2)
wma2 = ta.wma(source2, length2)
vwma2 = ta.vwma(source2, length2)
hma2 = ta.hma(source2, length2)
rma2 = ta.rma(source2, length2)
ma2 = (sma2 + ema2 + wma2 + vwma2 + hma2 + rma2) / 6

sma3 = ta.sma(source3, length3)
ema3 = ta.ema(source3, length3)
wma3 = ta.wma(source3, length3)
vwma3 = ta.vwma(source3, length3)
hma3 = ta.hma(source3, length3)
rma3 = ta.rma(source3, length3)
ma3 = (sma3 + ema3 + wma3 + vwma3 + hma3 + rma3) / 6

volumeMedian = ta.median(volume, 10)
volumeBuy = volume > volumeMedian and volume < volumeMedian * 2
highVolumeBuy = volume > volumeMedian * 2

greenCloud = ma2 > ma3
redCloud = not greenCloud

ma50 = plot(ma2On ? ma2 : na, "Moving Average #2", color=greenCloud ? aboveColor2 : belowColor2, linewidth=2, editable=false)
ma100 = plot(ma3On ? ma3 : na, "Moving Average #3", color=greenCloud ? aboveColor3 : belowColor3, linewidth=2, editable=false)

fill(ma50, ma100, color=greenCloud and highVolumeBuy ? color.new(bullcolor, 10) : greenCloud and volumeBuy ? color.new(bullcolor, 50) : greenCloud ? color.new(bullcolor, 80) : redCloud and highVolumeBuy ? color.new(bearcolor, 10) : redCloud and volumeBuy ? color.new(bearcolor, 50) : redCloud ? color.new(bearcolor, 80) : na)

// Trap Detector
wavetrend(src, chlLen, avgLen) =>
    esa = ta.ema(src, chlLen)
    d = ta.ema(math.abs(src - esa), chlLen)
    ci = (src - esa) / (0.015 * d)
    wt1 = ta.ema(ci, avgLen)
    wt2 = ta.sma(wt1, 3)
    [wt1, wt2]

f_top_fractal(src) => src[4] < src[2] and src[3] < src[2] and src[2] > src[1] and src[2] > src[0]
f_bot_fractal(src) => src[4] > src[2] and src[3] > src[2] and src[2] < src[1] and src[2] < src[0]
f_fractalize(src) => f_top_fractal(src) ? 1 : f_bot_fractal(src) ? -1 : 0

f_findDivs(src, topLimit, botLimit) =>
    fractalTop = f_fractalize(src) > 0 and src[2] >= topLimit ? src[2] : na
    fractalBot = f_fractalize(src) < 0 and src[2] <= botLimit ? src[2] : na
    highPrev = ta.valuewhen(not na(fractalTop), src[2], 0)[2]
    highPrice = ta.valuewhen(not na(fractalTop), high[2], 0)[2]
    lowPrev = ta.valuewhen(not na(fractalBot), src[2], 0)[2]
    lowPrice = ta.valuewhen(not na(fractalBot), low[2], 0)[2]
    bearSignal = not na(fractalTop) and high[1] > highPrice and src[1] < highPrev
    bullSignal = not na(fractalBot) and low[1] < lowPrice and src[1] > lowPrev
    [bearSignal, bullSignal]

[wt1, wt2] = wavetrend(close, 5 * TBSensi, 10 * TBSensi)
[wtDivBear1, wtDivBull1] = f_findDivs(wt2, 15, -40)
[wtDivBear2, wtDivBull2] = f_findDivs(wt2, 45, -65)

plotshape(ta.crossover(wt1, wt2) and Show_PR and wt2 <= -53, "Don't Sell/Bottom", shape.xcross, location.belowbar, color=bullcolor, size=size.tiny)
plotshape(ta.crossunder(wt1, wt2) and Show_PR and wt2 >= 53, "Don't Buy/Top", shape.xcross, location.abovebar, color=bearcolor, size=size.tiny)

// Trailing SL
ShowTrailingSl = input.bool(false, "Show Trailing Stoploss", group="Trailing Stoploss")
sl_type   = input.string("%", "Trailing SL Type", options=["%", "ATR", "Absolute"], group="Trailing Stoploss")
sl_perc   = input.float(0.4, "Trailing Sp - %", step=0.1, group="Trailing Stoploss")
atr_length = input.int(14, "Trailing Sp - Atr Length", group="Trailing Stoploss")
atr_mult  = input.float(2.0, "Trailing Sl - Atr Multiplier", group="Trailing Stoploss")
sl_absol  = input.float(10, "Trailing Sl - Absolute", group="Trailing Stoploss")

sl_val = sl_type == "ATR" ? atr_mult * ta.atr(atr_length) : sl_type == "Absolute" ? sl_absol : close * sl_perc / 100

var int pos = 0
var float trailing_sl = 0.0

long_signal  = not na(bull) and ShowTrailingSl
short_signal = not na(bear) and ShowTrailingSl

trailing_sl := short_signal ? high + sl_val : long_signal ? low - sl_val : nz(pos[1]) == 1 ? math.max(low - sl_val, nz(trailing_sl[1])) : nz(pos[1]) == -1 ? math.min(high + sl_val, nz(trailing_sl[1])) : nz(trailing_sl[1])
pos := long_signal ? 1 : short_signal ? -1 : nz(pos[1])

plot(ShowTrailingSl ? trailing_sl : na, "Trailing StopLoss", linewidth=2, color=pos == 1 ? bullcolor : bearcolor)

// Alerts
alertcondition(dir == 1 and dir[1] == -1, "BUY", "Pair : {{ticker}} | Type: Long 🟢 | TimeFrame : {{interval}} | Entry Price - {{close}} | SL - {{plot(\"SL\")}} | TP1 - {{plot(\"TP1\")}} | TP2 - {{plot(\"TP2\")}} | TP3 - {{plot(\"TP3\")}}")
alertcondition(dir == -1 and dir[1] == 1, "SELL", "Pair : {{ticker}} | Type: Short 🔴 | TimeFrame : {{interval}} | Entry Price - {{close}} | SL - {{plot(\"SL\")}} | TP1 - {{plot(\"TP1\")}} | TP2 - {{plot(\"TP2\")}} | TP3 - {{plot(\"TP3\")}}")
alertcondition((long_sl2 and last_longCondition2 > nz(last_long_close2[1])) or (short_sl2 and last_shortCondition2 > nz(last_short_close2[1])), "SL Hit - DYNAMIC")
alertcondition((short_sl and last_shortCondition > nz(last_short_close[1])) or (long_sl and last_longCondition > nz(last_long_close[1])), "BREAKEVEN - DYNAMIC")
alertcondition((short_tp and last_shortCondition > nz(last_short_close[1])) or (long_tp and last_longCondition > nz(last_long_close[1])), "Target 1 Hit - DYNAMIC")
alertcondition((short_tp2 and last_shortCondition2 > nz(last_short_close2[1])) or (long_tp2 and last_longCondition2 > nz(last_long_close2[1])), "Target 2 Hit - DYNAMIC")
alertcondition((short_tp3 and last_shortCondition3 > nz(last_short_close3[1])) or (long_tp3 and last_longCondition3 > nz(last_long_close3[1])), "Target 3 Hit - DYNAMIC")
alertcondition(short_signal or long_signal, "Trailing SL", "Trailing SL")

// Ribbon
xsrc = close
xprd1 = 12
xsrc2 = close
xprd2 = 26
xsmooth = 1

xPrice = ta.ema(xsrc, xsmooth)
FastMA = xfixtf ? ta.ema(request.security(syminfo.tickerid, xtf, ta.ema(xsrc, xprd1)), xsmooth) : ta.ema(xPrice, xprd1)
xPrice2 = ta.ema(xsrc2, xsmooth)
SlowMA = xfixtf ? ta.ema(request.security(syminfo.tickerid, xtf, ta.ema(xsrc2, xprd2)), xsmooth) : ta.ema(xPrice2, xprd2)

BullTribbon = FastMA > SlowMA
Tribbon = FastMA < SlowMA

Green  = BullTribbon and xPrice > FastMA
Red    = Tribbon and xPrice < FastMA

buycond  = Green and not Green[1]
sellcond = Red and not Red[1]

bullTribbonish = ta.barssince(buycond) < ta.barssince(sellcond)
Tribbonish     = ta.barssince(sellcond) < ta.barssince(buycond)

bColor_BullTribbonTribbon = bullTribbonish ? bullcolor : Tribbonish ? bearcolor : na

plotshape(plotRibsw and plotRibbonPos == "Top" ? close : na, style=shape.square, title="Buy/Sell Ribbon", location=location.top, color=bColor_BullTribbonTribbon, editable=false)
plotshape(plotRibsw and plotRibbonPos == "Bottom" ? close : na, style=shape.square, title="Buy/Sell Ribbon", location=location.bottom, color=bColor_BullTribbonTribbon, editable=false)

buy  = Tribbonish[1] and buycond
sell = bullTribbonish[1] and sellcond

labelstyle   = close > SlowMA ? label.style_label_down : label.style_label_up
labelyloc    = close > SlowMA ? yloc.abovebar : yloc.belowbar
labeltcolor  = buy ? color.black : sell ? color.white : close > close[1] ? bullcolor : bearcolor
labelbgcolor = buy ? bullcolor : sell ? bearcolor : color.silver
labeltext    = buy ? "Long on next bar\n" : sell ? "Short on next bar\n" : " "
trendText    = bullTribbonish ? "Bullish" : Tribbonish ? "Bearish" : "Sideways"

l1 = label.new(bar_index, na, text=labeltext + syminfo.ticker + " " + str.tostring(close) + " " + syminfo.currency + "\n Currently in a " + trendText + " Trend \n", color=labelbgcolor, textcolor=labeltcolor, yloc=labelyloc, style=labelstyle)
label.delete(labelSwitch ? l1[1] : l1)